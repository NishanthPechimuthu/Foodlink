# ===================================================
# FOOD LINK - MASTER ENVIRONMENT CONFIGURATION
# ===================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/food-link

# JWT AUTHENTICATION
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_here

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMS OTP SERVICE (MSG91 & Fallback)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=FDLINK
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=true

# CLOUDINARY IMAGE STORAGE
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CLIENT CONFIGURATION (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
