PORT=5001
NODE_ENV=development
# Public URL of the deployed frontend (no trailing slash). Used for CORS and email links.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas URI (Provide your real MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-link?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# JWT Configuration
JWT_SECRET=super_secure_food_link_jwt_secret_dev_key_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secure_food_link_cookie_secret_dev_key_2026

# ---------------------------------------------------------------------------
# Email — Brevo SMTP (signup verification + password reset + donation codes)
# ---------------------------------------------------------------------------
# Get SMTP credentials from Brevo -> Settings -> SMTP & API -> SMTP.
# Use an SMTP key, NOT an API key. The SMTP login may be your Brevo account
# email or an automatically generated [ID]@smtp-brevo.com address.
BREVO_SMTP_HOST=smtp-relay.brevo.com
# 2525 works on Render Free (Render blocks outbound ports 25/465/587).
# Use 587 for STARTTLS elsewhere, or 465 with BREVO_SMTP_SECURE=true.
BREVO_SMTP_PORT=2525
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_key
# Must be a sender/domain verified in Brevo. Example:
# BREVO_FROM=Food Link <no-reply@yourdomain.com>
BREVO_FROM=Food Link <no-reply@example.com>
# true = log emails to the server console instead of sending (useful locally).
# false is authoritative even when NODE_ENV is not "production".
EMAIL_DEV_MODE=true

# ---------------------------------------------------------------------------
# SMS — Twilio (listing publish OTP + receiver pickup OTP)
# ---------------------------------------------------------------------------
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Use either a Twilio phone number or a Messaging Service SID
TWILIO_PHONE_NUMBER=+12025550123
TWILIO_MESSAGING_SERVICE_SID=
# true = log SMS to the server console instead of sending (useful locally)
SMS_DEV_MODE=true

# ---------------------------------------------------------------------------
# One-time code behaviour
# ---------------------------------------------------------------------------
# When true, OTP codes are also returned in API responses so you can test
# without real SMS/email. MUST be false in production.
OTP_DEV_MODE=true

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Administrative Provisioning
ADMIN_EMAIL=admin@foodlink.org
ADMIN_PASSWORD=FoodLinkAdmin@2026!
ADMIN_NAME=Food Link Administrator
ADMIN_PHONE=+91 99999 88888

# Cloudinary (Used in Phase 4 for food photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
